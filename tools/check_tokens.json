{
  "name": "check_tokens",
  "description": "验证 GitHub 和 GitCode 的访问 Token 是否有效。所有上传操作的前置步骤。",
  "arguments": {
    "type": "object",
    "properties": {
      "token_gh": {
        "type": "string",
        "description": "GitHub Personal Access Token"
      },
      "token_gt": {
        "type": "string",
        "description": "GitCode Access Token"
      }
    },
    "required": ["token_gh", "token_gt"]
  }
}
